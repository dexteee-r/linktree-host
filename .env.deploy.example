# Copy to .env.deploy (gitignored) and adjust. Used by deploy.sh.
# REMOTE_USER=root: accès SSH root confirmé sur vm-extranet (.111, hôte NPM).
# Pas de compte "webadmin" connu sur cette VM (contrairement à lxc-web/.112).
REMOTE_USER=root
REMOTE_HOST=192.168.1.111
REMOTE_PATH=/opt/linktree-host
SSH_PORT=22
