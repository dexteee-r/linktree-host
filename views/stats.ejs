<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stats — Linktree</title>
  <meta name="theme-color" content="#050505" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="stylesheet" href="/public/style.css" />
</head>
<body>
  <main class="card">
    <p class="prompt-line"><span class="sigil">~$</span> cat stats.log</p>
    <h1>Statistiques</h1>
    <p class="bio">Vues totales de la page : <strong><%= pageViews %></strong></p>
    <table class="stats-table">
      <thead>
        <tr><th>Lien</th><th>Clics</th></tr>
      </thead>
      <tbody>
        <% stats.forEach(function (s) { %>
          <tr><td><%= s.label %></td><td><%= s.clicks %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </main>
</body>
</html>
