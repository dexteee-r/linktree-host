<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050505">
<title><%= config.title %></title>
<meta name="description" content="<%= config.bio || config.title %>">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-sans/style.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-mono/style.css">
<link rel="stylesheet" href="/public/style.css">
<% if (config.theme && config.theme.accentColor) { %>
<style>:root { --accent: <%= config.theme.accentColor %>; }</style>
<% } %>
</head>
<body>

<div class="noise-overlay"></div>

<div class="wrapper">

  <section class="section-block">
    <p class="section-header">// profile</p>
    <div class="title-block">
      <div class="status"><span class="dot"></span> en ligne</div>
      <% if (config.avatarUrl) { %>
        <img class="avatar" src="<%= config.avatarUrl %>" alt="<%= config.title %>">
      <% } %>
      <% var titleParts = config.title.split('_'); %>
      <h1>
        <%= titleParts[0].toUpperCase() %>
        <% if (titleParts.length > 1) { %>
          <br><span class="muted"><%= titleParts.slice(1).join('_').toUpperCase() %></span>
        <% } %>
      </h1>
      <% if (config.bio) { %><p class="bio-text"><%= config.bio %></p><% } %>
    </div>
  </section>

  <section class="section-block">
    <p class="section-header">// liens</p>
    <nav class="links" aria-label="Liens">
      <% config.links.forEach(function (link) { %>
        <a class="link-btn" href="/l/<%= link.slug %>" target="_blank" rel="noopener noreferrer">
          <span class="link-icon" aria-hidden="true">
            <% if (link.slug === 'github') { %>
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.54-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.04.13 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.82.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <% } else if (link.icon) { %>
              <%= link.icon %>
            <% } %>
          </span>
          <span class="link-title"><%= link.label %></span>
        </a>
      <% }); %>
    </nav>
  </section>

  <footer>&copy; <%= new Date().getFullYear() %> // <%= config.footer || '' %></footer>

</div>
</body>
</html>
