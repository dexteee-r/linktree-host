<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050505">
<title>Stats — Linktree</title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-sans/style.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-mono/style.css">
<link rel="stylesheet" href="/public/style.css">
</head>
<body>

<div class="noise-overlay"></div>

<div class="wrapper">
  <section class="section-block">
    <p class="section-header">// stats</p>
    <h1 style="font-size: 1.8rem;">Statistiques</h1>
    <p class="bio-text">Vues totales de la page : <strong style="color: var(--text);"><%= pageViews %></strong></p>
  </section>

  <section class="section-block">
    <table class="stats-table">
      <thead>
        <tr><th>Lien</th><th>Clics</th></tr>
      </thead>
      <tbody>
        <% stats.forEach(function (s) { %>
          <tr><td><%= s.label %></td><td><%= s.clicks %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </section>
</div>
</body>
</html>
