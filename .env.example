# Copy this file to .env on the SERVER (vm-extranet), never commit the real .env.
STATS_USER=admin
STATS_PASS=change-me-please

# Name of the existing Docker network that Nginx Proxy Manager's container
# is attached to. REQUIRED — find the real value on the server with:
# docker network ls (do not guess, docker compose will refuse to start
# without it set).
NPM_NETWORK_NAME=
